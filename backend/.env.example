# Backend Environment Configuration Example
# Copy to .env for local development

# Application Server
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# JWT Secret & Encryption
SECRET_KEY=generate_a_super_secret_jwt_key_here_minimum_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Supabase PostgreSQL)
# Format: postgresql+asyncpg://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# Leave empty to automatically use High-Fidelity Local Demo Mode
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional AI Key (OpenAI / Gemini for optional LLM conversational extensions)
# If not provided, the system seamlessly uses the built-in Scikit-learn + NLP rule engine
AI_PROVIDER=builtin
AI_API_KEY=

